# Auth (Better Auth) — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-random-secret-minimum-32-chars

# Database (any Postgres — self-hosted, Supabase, Neon, RDS, etc.)
DATABASE_URL=postgresql://user:password@localhost:5432/wrenchly
DIRECT_URL=postgresql://user:password@localhost:5432/wrenchly

# Resend (email)
RESEND_API_KEY=re_your_key

# Cron job protection
CRON_SECRET=your-very-long-random-secret-minimum-32-chars

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
